{
  "name": "a4sx",
  "displayName": "a4sx",
  "description": "Use a4sx from VS Code: sign in, browse and resume your saved sessions, search the marketplace, and add the a4sx MCP servers for agent mode.",
  "version": "0.2.0",
  "publisher": "crossvaultGmbH",
  "license": "Apache-2.0",
  "homepage": "https://session-exchange.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/crossvault/a4sx-mcp.git",
    "directory": "vscode"
  },
  "bugs": {
    "url": "https://github.com/crossvault/a4sx-mcp/issues"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "a4sx",
    "mcp",
    "agent sessions",
    "claude code",
    "copilot"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Saving a session runs the a4sx CLI in a local terminal, which needs a local workspace."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "a4sx.saveSession",
        "title": "Save this session",
        "category": "a4sx",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "a4sx.openLibrary",
        "title": "Open my library",
        "category": "a4sx",
        "icon": "$(link-external)"
      },
      {
        "command": "a4sx.signIn",
        "title": "Sign in",
        "category": "a4sx"
      },
      {
        "command": "a4sx.signOut",
        "title": "Sign out",
        "category": "a4sx"
      },
      {
        "command": "a4sx.refreshSessions",
        "title": "Refresh",
        "category": "a4sx",
        "icon": "$(refresh)"
      },
      {
        "command": "a4sx.resumeSession",
        "title": "Resume in terminal",
        "category": "a4sx",
        "icon": "$(terminal)"
      },
      {
        "command": "a4sx.openSessionOnWeb",
        "title": "Open on the web",
        "category": "a4sx",
        "icon": "$(globe)"
      },
      {
        "command": "a4sx.copySessionId",
        "title": "Copy session id",
        "category": "a4sx"
      },
      {
        "command": "a4sx.searchMarketplace",
        "title": "Search the marketplace",
        "category": "a4sx",
        "icon": "$(search)"
      },
      {
        "command": "a4sx.openListing",
        "title": "Open on the web",
        "category": "a4sx",
        "icon": "$(globe)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "a4sx",
          "title": "a4sx",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "a4sx": [
        {
          "id": "a4sx.sessions",
          "name": "My sessions",
          "icon": "media/icon.png"
        },
        {
          "id": "a4sx.marketplace",
          "name": "Marketplace",
          "icon": "media/icon.png"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "a4sx.sessions",
        "contents": "Sign in to a4sx to see the sessions in your library.\n[Sign in to a4sx](command:a4sx.signIn)",
        "when": "!a4sx.signedIn"
      },
      {
        "view": "a4sx.sessions",
        "contents": "Your library has no sessions yet. Save your latest Claude Code session to add one.\n[Save this session](command:a4sx.saveSession)",
        "when": "a4sx.signedIn && a4sx.sessionsEmpty"
      },
      {
        "view": "a4sx.marketplace",
        "contents": "Find sessions that others publish on the a4sx marketplace.\n[Search the marketplace](command:a4sx.searchMarketplace)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "a4sx.saveSession",
          "when": "view == a4sx.sessions",
          "group": "navigation@1"
        },
        {
          "command": "a4sx.refreshSessions",
          "when": "view == a4sx.sessions && a4sx.signedIn",
          "group": "navigation@2"
        },
        {
          "command": "a4sx.openLibrary",
          "when": "view == a4sx.sessions",
          "group": "more@1"
        },
        {
          "command": "a4sx.signOut",
          "when": "view == a4sx.sessions && a4sx.signedIn",
          "group": "more@2"
        },
        {
          "command": "a4sx.searchMarketplace",
          "when": "view == a4sx.marketplace",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "a4sx.resumeSession",
          "when": "view == a4sx.sessions && viewItem == a4sx.session",
          "group": "inline@1"
        },
        {
          "command": "a4sx.openSessionOnWeb",
          "when": "view == a4sx.sessions && viewItem == a4sx.session",
          "group": "inline@2"
        },
        {
          "command": "a4sx.resumeSession",
          "when": "view == a4sx.sessions && viewItem == a4sx.session",
          "group": "1_session@1"
        },
        {
          "command": "a4sx.openSessionOnWeb",
          "when": "view == a4sx.sessions && viewItem == a4sx.session",
          "group": "1_session@2"
        },
        {
          "command": "a4sx.copySessionId",
          "when": "view == a4sx.sessions && viewItem == a4sx.session",
          "group": "1_session@3"
        },
        {
          "command": "a4sx.openListing",
          "when": "view == a4sx.marketplace && viewItem == a4sx.listing",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "a4sx.signIn",
          "when": "!a4sx.signedIn"
        },
        {
          "command": "a4sx.signOut",
          "when": "a4sx.signedIn"
        },
        {
          "command": "a4sx.refreshSessions",
          "when": "a4sx.signedIn"
        },
        {
          "command": "a4sx.resumeSession",
          "when": "false"
        },
        {
          "command": "a4sx.openSessionOnWeb",
          "when": "false"
        },
        {
          "command": "a4sx.copySessionId",
          "when": "false"
        },
        {
          "command": "a4sx.openListing",
          "when": "false"
        }
      ]
    },
    "authentication": [
      {
        "id": "a4sx",
        "label": "a4sx"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "a4sx.mcpServers",
        "label": "a4sx"
      }
    ],
    "configuration": {
      "title": "a4sx",
      "properties": {
        "a4sx.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Full path to the `a4sx` command. Leave empty to find `a4sx` on your `PATH`."
        },
        "a4sx.serverUrl": {
          "type": "string",
          "default": "https://session-exchange.com",
          "scope": "application",
          "markdownDescription": "The a4sx server the sidebar signs in to and lists sessions from. Change it only if you use a different a4sx server. It must be an HTTPS address."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "mocha --require ./out/test/fakeVscode.js \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run compile && vscode-test",
    "package": "vsce package --no-dependencies",
    "ls": "vsce ls --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.0",
    "@types/vscode": "1.101.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "mocha": "^11.7.0",
    "typescript": "^5.9.2"
  }
}
